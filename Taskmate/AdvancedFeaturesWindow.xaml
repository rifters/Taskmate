<Window x:Class="Taskmate.AdvancedFeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Features" Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enable Advanced Features" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Choose which advanced features you want to use. Disabled features will be hidden from menus." 
                   TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Core Features -->
                <TextBlock Text="Core Features" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkConstraints" Content="Task Constraints" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Exclude specific people from specific tasks (allergies, physical limitations, skill requirements).
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkHistory" Content="Persistent History" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Save all assignments permanently with search, filtering, and report generation capabilities.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Task Management -->
                <TextBlock Text="Task Management" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkTaskWeighting" Content="Task Difficulty/Weighting" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Assign difficulty levels (Easy, Medium, Hard) to tasks for balanced distribution.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkTaskTimeEstimates" Content="⏰ Task Time Estimates" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Assign time estimates to tasks and balance by total time instead of just task count.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkTaskCategories" Content="📁 Task Categories" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Organize tasks by category (Cleaning, Cooking, Service) for better organization and balanced distribution.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- People Management -->
                <TextBlock Text="People Management" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkAvailability" Content="Person Availability" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Mark people as available or unavailable to temporarily exclude them from assignments.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkRoles" Content="Role-Based Assignment" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Assign roles to people (Server, Cook, Host, etc.) for structured team management.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Assignment Features -->
                <TextBlock Text="Assignment Features" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoRotation" Content="🔄 Auto-Rotation System" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Track assignments over time and automatically rotate to ensure long-term fairness.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkAssignmentTemplates" Content="📝 Assignment Templates" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Save and reuse successful assignments as templates for future use.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkAssignmentNotes" Content="💬 Assignment Notes" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Add notes and comments to assignments for context and tracking.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkAssignmentScheduler" Content="📅 Assignment Scheduler" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Plan and schedule assignments in advance with calendar view.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Output & Export -->
                <TextBlock Text="Output &amp; Export" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkPrintPreview" Content="Print Preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Professional print-friendly view for posting schedules on bulletin boards.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkMobileExport" Content="📱 Mobile-Friendly Export" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Generate mobile-optimized HTML pages and QR codes for easy phone access.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Workflow Tools -->
                <TextBlock Text="Workflow Tools" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkCompletionTracking" Content="✅ Task Completion Tracking" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Track which tasks are completed during assignments. Mark individual tasks complete with strikethrough, view completion status in history (Green/Yellow/Red).
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkQuickSwap" Content="Quick Swap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Quickly swap all tasks between two people for last-minute schedule changes.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkBulkEditMode" Content="⚡ Bulk Edit Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Edit multiple tasks or people at once for faster configuration.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Analytics & Insights -->
                <TextBlock Text="Analytics &amp; Insights" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkPerformanceAnalytics" Content="📊 Performance Analytics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Long-term fairness tracking, heat maps, and management reports.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkNotifications" Content="🔔 Notification System" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Desktop notifications when assignments change (email/SMS coming soon).
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Configuration Options -->
                <TextBlock Text="Configuration" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkTagging" Content="Enable Task Tagging" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Allow assigning tags to tasks for better organization and filtering.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <CheckBox x:Name="chkTaggingAtAssignment" Content="🏷️ Tag at Assignment Time" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="20,0,0,0">
                            Tag assignments when created (uses group tag if available) and allow re-tagging when posting. Useful for organizing by role/station (Cooks, Servers, Hosts, etc).
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Assignment Save Location" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,0,0,8">
                            Leave empty to save in application directory. Assignments will be saved to assignments.txt in this location.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="txtAssignmentLocation" Height="35" Padding="10" FontSize="12" Margin="0,0,10,0" HorizontalAlignment="Stretch"/>
                            <Button x:Name="btnBrowseLocation" Content="Browse" Width="80" Height="35" Click="btnBrowseLocation_Click"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,0">
                            Example: C:\Users\YourName\Documents\Assignments
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Select All" Width="100" Height="35" Margin="0,0,10,0" Click="btnSelectAll_Click"/>
            <Button Content="Deselect All" Width="100" Height="35" Margin="0,0,10,0" Click="btnDeselectAll_Click"/>
            <Button Content="Reset to Defaults" Width="130" Height="35" Margin="0,0,10,0" Click="btnReset_Click"/>
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>