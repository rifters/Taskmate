<Window x:Class="Taskmate.AnalyticsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Analytics" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Performance Analytics Dashboard" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Date Range:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbDateRange" Width="150" Height="30" SelectionChanged="cmbDateRange_SelectionChanged">
                <ComboBoxItem Content="Last 7 Days" IsSelected="True"/>
                <ComboBoxItem Content="Last 30 Days"/>
                <ComboBoxItem Content="Last 90 Days"/>
                <ComboBoxItem Content="All Time"/>
            </ComboBox>
            <Button Content="Refresh" Width="100" Height="30" Margin="20,0,0,0" Click="btnRefresh_Click"/>
        </StackPanel>

        <TabControl Grid.Row="2">
            <!-- Overview Tab -->
            <TabItem Header="📊 Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Summary Cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#667eea" Padding="20" Margin="5" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Total Assignments" Foreground="White" Opacity="0.9" FontSize="12"/>
                                    <TextBlock x:Name="txtTotalAssignments" Text="0" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#f093fb" Padding="20" Margin="5" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Total Tasks" Foreground="White" Opacity="0.9" FontSize="12"/>
                                    <TextBlock x:Name="txtTotalTasks" Text="0" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#4facfe" Padding="20" Margin="5" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Active People" Foreground="White" Opacity="0.9" FontSize="12"/>
                                    <TextBlock x:Name="txtActivePeople" Text="0" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#43e97b" Padding="20" Margin="5" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Avg Fairness" Foreground="White" Opacity="0.9" FontSize="12"/>
                                    <TextBlock x:Name="txtAvgFairness" Text="0%" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Charts Placeholder -->
                        <TextBlock Text="Task Distribution Over Time" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="200" Margin="0,0,0,20">
                            <Canvas x:Name="chartCanvas" Background="White"/>
                        </Border>

                        <TextBlock Text="Top Contributors" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10"/>
                        <DataGrid x:Name="dgTopContributors" Height="200" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60"/>
                                <DataGridTextColumn Header="Person" Binding="{Binding Person}" Width="*"/>
                                <DataGridTextColumn Header="Total Tasks" Binding="{Binding TotalTasks}" Width="100"/>
                                <DataGridTextColumn Header="Assignments" Binding="{Binding AssignmentCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Fairness Tab -->
            <TabItem Header="⚖️ Fairness">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Fairness Analysis" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <TextBlock Text="Analyze how evenly tasks are distributed among team members" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,20"/>

                        <DataGrid x:Name="dgFairness" Height="400" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Person" Binding="{Binding Person}" Width="*"/>
                                <DataGridTextColumn Header="Total Tasks" Binding="{Binding TotalTasks}" Width="100"/>
                                <DataGridTextColumn Header="Avg per Assignment" Binding="{Binding AvgTasks}" Width="150"/>
                                <DataGridTextColumn Header="Fairness Score" Binding="{Binding FairnessScore}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Task Frequency Tab -->
            <TabItem Header="📈 Task Frequency">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Most Assigned Tasks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <DataGrid x:Name="dgTaskFrequency" Height="500" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="2*"/>
                                <DataGridTextColumn Header="Times Assigned" Binding="{Binding Count}" Width="120"/>
                                <DataGridTextColumn Header="People" Binding="{Binding UniquePeople}" Width="100"/>
                                <DataGridTextColumn Header="Last Assigned" Binding="{Binding LastDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Export Report" Width="120" Height="35" Margin="0,0,10,0" Click="btnExportReport_Click"/>
            <Button Content="Close" Width="100" Height="35" Click="btnClose_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>