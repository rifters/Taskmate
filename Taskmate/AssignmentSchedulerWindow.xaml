<Window x:Class="Taskmate.AssignmentSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assignment Scheduler" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assignment Scheduler" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📅 Upcoming in next 7 days:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="txtUpcomingCount" Text="0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="➕ New" Width="100" Height="35" Margin="0,0,10,0" Click="btnNew_Click"/>
                <Button Content="✏️ Edit" Width="100" Height="35" Margin="0,0,10,0" Click="btnEdit_Click"/>
                <Button Content="🗑️ Delete" Width="100" Height="35" Margin="0,0,10,0" Click="btnDelete_Click"/>
                <Button Content="▶️ Execute Now" Width="120" Height="35" Margin="0,0,10,0" Click="btnExecute_Click"/>
                <Button Content="🔄 Refresh" Width="100" Height="35" Click="btnRefresh_Click"/>
            </StackPanel>

            <DataGrid x:Name="dgScheduled" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" 
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <EventSetter Event="Click" Handler="chkEnabled_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Scheduled Date" Binding="{Binding ScheduledDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                    <DataGridTextColumn Header="Recurrence" Width="100">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} ({1})">
                                <Binding Path="RecurrenceType"/>
                                <Binding Path="RecurrenceInterval"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Group File" Binding="{Binding GroupFilePath}" Width="*"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="150"/>
                    <DataGridTextColumn Header="Last Executed" Binding="{Binding LastExecuted, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Button Grid.Row="3" Content="Close" Width="100" Height="35" HorizontalAlignment="Right" Margin="0,15,0,0" Click="btnClose_Click" IsDefault="True"/>
    </Grid>
</Window>