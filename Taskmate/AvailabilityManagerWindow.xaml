<Window x:Class="Taskmate.AvailabilityManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Availability" Height="500" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mark people as available or unavailable" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Unavailable people will be excluded from assignments" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" x:Name="dgPeople" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Person" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Role" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AllRoles}" SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>