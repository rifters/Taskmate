<Window x:Class="Taskmate.BackupScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Schedule Settings" Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="💾 Automated Backup Schedule" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
            <TextBlock Text="Configure automatic backups to protect your data" 
                       FontSize="13" 
                       Opacity="0.7"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Enable Schedule -->
                <CheckBox x:Name="chkEnableSchedule" 
                          Content="Enable automatic backups" 
                          FontSize="14"
                          FontWeight="SemiBold"
                          Checked="chkEnableSchedule_Changed"
                          Unchecked="chkEnableSchedule_Changed"
                          Margin="0,0,0,20"/>

                <!-- Frequency -->
                <TextBlock Text="Backup Frequency:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbFrequency" 
                          SelectionChanged="cmbFrequency_SelectionChanged"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="Daily" Tag="Daily"/>
                    <ComboBoxItem Content="Weekly" Tag="Weekly" IsSelected="True"/>
                    <ComboBoxItem Content="Monthly" Tag="Monthly"/>
                </ComboBox>

                <!-- Day of Week (for Weekly) -->
                <StackPanel x:Name="pnlDayOfWeek" Margin="0,0,0,20">
                    <TextBlock Text="Preferred Day:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbDayOfWeek">
                        <ComboBoxItem Content="Sunday" Tag="Sunday" IsSelected="True"/>
                        <ComboBoxItem Content="Monday" Tag="Monday"/>
                        <ComboBoxItem Content="Tuesday" Tag="Tuesday"/>
                        <ComboBoxItem Content="Wednesday" Tag="Wednesday"/>
                        <ComboBoxItem Content="Thursday" Tag="Thursday"/>
                        <ComboBoxItem Content="Friday" Tag="Friday"/>
                        <ComboBoxItem Content="Saturday" Tag="Saturday"/>
                    </ComboBox>
                </StackPanel>

                <!-- Time -->
                <TextBlock Text="Preferred Time:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ComboBox x:Name="cmbHour" Width="60" Margin="0,0,10,0"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbMinute" Width="60" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbAmPm" Width="60">
                        <ComboBoxItem Content="AM"/>
                        <ComboBoxItem Content="PM"/>
                    </ComboBox>
                </StackPanel>

                <!-- Backup Location -->
                <TextBlock Text="Backup Location:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtBackupLocation" 
                             Grid.Column="0" 
                             IsReadOnly="True"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Width="80" 
                            Click="btnBrowse_Click"/>
                </Grid>

                <!-- Retention -->
                <TextBlock Text="Keep backups for:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBox x:Name="txtRetentionDays" 
                             Width="60" 
                             Text="30"
                             TextAlignment="Center"/>
                    <TextBlock Text=" days" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Notification -->
                <CheckBox x:Name="chkNotifyOnCompletion" 
                          Content="Show notification when backup completes" 
                          Margin="0,0,0,10"/>

                <!-- Last Backup Info -->
                <Border Background="#f5f5f5" 
                        Padding="15" 
                        CornerRadius="5" 
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Backup Information" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtLastBackup" 
                                   Text="Last backup: Never" 
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtNextBackup" 
                                   Text="Next backup: Not scheduled" 
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Test Backup Now" 
                    Width="120" 
                    Height="35" 
                    Margin="0,0,10,0" 
                    Click="btnTestBackup_Click"/>
            <Button Content="Save" 
                    Width="80" 
                    Height="35" 
                    Margin="0,0,10,0" 
                    Click="btnSave_Click" 
                    IsDefault="True"/>
            <Button Content="Cancel" 
                    Width="80" 
                    Height="35" 
                    Click="btnCancel_Click" 
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>