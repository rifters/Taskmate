<Window x:Class="Taskmate.ConstraintsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Constraints" Height="500" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,15">
            <Run Text="Define which people " FontWeight="Bold"/>
            <Run Text="cannot"/>
            <Run Text=" be assigned specific tasks. Select a person and tasks to exclude them from." FontWeight="Bold"/>
        </TextBlock>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- People List -->
            <GroupBox Grid.Column="0" Header="People" Padding="10">
                <ListBox x:Name="lstPeople" SelectionChanged="lstPeople_SelectionChanged"/>
            </GroupBox>

            <!-- Add/Remove Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                <Button Content="➡ Exclude" Width="100" Height="35" Margin="0,0,0,10" Click="btnExclude_Click"/>
                <Button Content="⬅ Allow" Width="100" Height="35" Click="btnAllow_Click"/>
            </StackPanel>

            <!-- Tasks List -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Available Tasks" Padding="10">
                    <ListBox x:Name="lstAvailableTasks" SelectionMode="Extended"/>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Excluded Tasks" Padding="10" Margin="0,10,0,0">
                    <ListBox x:Name="lstExcludedTasks" SelectionMode="Extended"/>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Clear All Constraints" Width="150" Height="35" Margin="0,0,10,0" Click="btnClearAll_Click"/>
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>