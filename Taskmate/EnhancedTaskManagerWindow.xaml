<Window x:Class="Taskmate.EnhancedTaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enhanced Task Manager" Height="650" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Task Management with Time Estimates &amp; Categories" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Set difficulty, time estimates, categories, and notes for each task" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" x:Name="dgTasks" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Category" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Difficulty" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding DifficultyDisplay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Time (min)" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TimeEstimate, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Manage Categories..." Width="140" Height="35" Margin="0,0,10,0" Click="btnManageCategories_Click"/>
            <Button Content="Bulk Edit Selected" Width="130" Height="35" Margin="0,0,10,0" Click="btnBulkEdit_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="200,0,0,0">
                <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>