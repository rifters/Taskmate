                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,5">
                            <Run Text="📊 Balance by Difficulty:" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,10">
