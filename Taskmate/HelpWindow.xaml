<Window x:Class="Taskmate.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assigner - Help" Height="650" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10">
            <!-- Getting Started Tab -->
            <TabItem Header="🚀 Getting Started">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Welcome to Task Assigner!" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="What is Task Assigner?" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            Task Assigner helps you randomly distribute tasks among people fairly. Perfect for restaurants, offices, households, or any team that needs random task distribution with smart load balancing.
                        </TextBlock>

                        <TextBlock Text="Quick Start Guide:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,5">
                            <Run Text="1. " FontWeight="Bold"/>
                            <Run Text="Load or create a task list using 📂 Load Tasks or ✏️ Manage Tasks"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,5">
                            <Run Text="2. " FontWeight="Bold"/>
                            <Run Text="Load or create a people list using 📂 Load People or ✏️ Manage People"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,5">
                            <Run Text="3. " FontWeight="Bold"/>
                            <Run Text="(Optional) Set constraints, availability, or task properties"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,5">
                            <Run Text="4. " FontWeight="Bold"/>
                            <Run Text="Click 🎲 Assign Tasks (or press F5) to randomly distribute tasks"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,15">
                            <Run Text="5. " FontWeight="Bold"/>
                            <Run Text="View results, check 📊 Stats, copy, export, or print assignments"/>
                        </TextBlock>

                        <TextBlock Text="Drag and Drop Support:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            You can drag and drop .txt files directly onto the window. Files with "task" in the name will be loaded as tasks, files with "people" or "person" will be loaded as people.
                        </TextBlock>

                        <TextBlock Text="Keyboard Shortcuts:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Press <Run FontWeight="Bold">Ctrl+H</Run> to open this help, or see the full list under Help → Keyboard Shortcuts.
                        </TextBlock>

                        <TextBlock Text="Try the Samples:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            New to Task Assigner? Use <Run FontWeight="Bold">File → Load Sample Files</Run> to instantly load example tasks and people. Perfect for testing and learning how the app works!
                        </TextBlock>

                        <Border Background="#e3f2fd" Padding="15" Margin="0,10,0,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="💡 Pro Tip" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12">
                                    Task Assigner has many advanced features that can be enabled in Settings → Advanced Features. Start with basic features and enable more as you need them!
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Dashboard Overview:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            The dashboard at the top of the main window shows at-a-glance information:
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">
                            📋 <Run FontWeight="Bold">Last Assignment</Run> - When you last assigned tasks and how many
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">
                            ⚖️ <Run FontWeight="Bold">Fairness Score</Run> - Live calculation of workload distribution (90%+ is excellent)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,15">
                            ⚡ <Run FontWeight="Bold">Quick Stats</Run> - Shows overloaded/underloaded person counts
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Managing Lists Tab -->
            <TabItem Header="📋 Managing Lists">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Task and People Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Loading from Files:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Use 📂 Load Tasks or 📂 Load People to import from text files. Files should have one item per line.
                        </TextBlock>

                        <TextBlock Text="Managing Lists:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run Text="✏️ Manage Tasks / ✏️ Manage People" FontWeight="Bold"/>
                            <Run Text=" - Opens the list manager where you can:"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Add new items manually</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Remove selected items</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Clear all items</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Import from .txt or .json files</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,15">• Export to .txt or .json files</TextBlock>

                        <TextBlock Text="Saving Groups:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Use <Run FontWeight="Bold">File → Save Group (Ctrl+S)</Run> to save both your tasks and people lists together as a single .tgroup file. Groups preserve all settings including task properties, availability, and roles.
                        </TextBlock>

                        <TextBlock Text="Recent Groups:" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Access your recently saved groups from <Run FontWeight="Bold">File → Recent Groups</Run> for quick loading. Your last 10 groups are always available!
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Assignment Features Tab -->
            <TabItem Header="🎲 Assignments">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Assignment Features" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="How Assignment Works:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            When you click 🎲 Assign Tasks (or press F5), both tasks and people are randomly shuffled, then tasks are distributed evenly among people. The system automatically balances workload and respects any constraints you've set.
                        </TextBlock>

                        <TextBlock Text="Understanding the Results Grid:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • <Run FontWeight="Bold">Person</Run> - Name of the person
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • <Run FontWeight="Bold">Tasks</Run> - Number of tasks assigned
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • <Run FontWeight="Bold">Workload</Run> - Percentage compared to average (100% = average load)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            • <Run FontWeight="Bold">Assigned Tasks</Run> - List of all tasks for that person
                        </TextBlock>

                        <TextBlock Text="Viewing Statistics:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Click <Run FontWeight="Bold">📊 Stats</Run> to view detailed statistics including:
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Total tasks and people</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Average tasks per person</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Fairness score (0-100%, higher is better)</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,15">• Visual distribution bars showing workload</TextBlock>

                        <TextBlock Text="Output File:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Each assignment is automatically saved to "assignments.txt" in the application directory for easy reference.
                        </TextBlock>

                        <TextBlock Text="Undo and History:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • Use <Run FontWeight="Bold">↩️ Undo (Ctrl+Z)</Run> to revert to the previous assignment
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • View session history via <Run FontWeight="Bold">Edit → View Session History</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • Browse ALL history (even from previous days) via <Run FontWeight="Bold">Edit → Browse All History (Ctrl+Shift+H)</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • All assignments are automatically saved permanently to your history archive
                        </TextBlock>

                        <TextBlock Text="Visual Workload Indicators:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Assignments are color-coded for instant visual feedback on workload balance:
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">
                            🔴 <Run FontWeight="Bold">Red background</Run> - Overloaded (&gt;120% workload)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">
                            🟡 <Run FontWeight="Bold">Yellow background</Run> - Slightly high (100-120% workload)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">
                            ⚪ <Run FontWeight="Bold">Normal</Run> - Balanced (80-100% workload)
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,15">
                            🟢 <Run FontWeight="Bold">Green background</Run> - Underloaded (&lt;80% workload)
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Copy & Export Tab -->
            <TabItem Header="📋 Copy &amp; Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Copying and Exporting Assignments" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Copy to Clipboard:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • Press <Run FontWeight="Bold">Ctrl+C</Run> or use <Run FontWeight="Bold">Edit → Copy All Assignments</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            • Right-click on the results grid for more copy options
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            • Select a person and choose "Copy Selected Person's Tasks" to copy just their tasks
                        </TextBlock>

                        <TextBlock Text="Export to CSV:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Use <Run FontWeight="Bold">File → Export to CSV</Run> to save assignments as a spreadsheet file that can be opened in Excel or Google Sheets.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                            Perfect for sharing with your team or keeping records!
                        </TextBlock>

                        <TextBlock Text="Print Preview:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Press <Run FontWeight="Bold">Ctrl+P</Run> or use <Run FontWeight="Bold">View → Print Preview</Run> to generate a print-friendly view perfect for posting on bulletin boards.
                        </TextBlock>

                        <TextBlock Text="Mobile Export:" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Use <Run FontWeight="Bold">Tools → Mobile Export</Run> to create:
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,5,0,5">• Mobile-optimized HTML page</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• QR code for easy phone access</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,15">• Staff can scan and view tasks on their phones!</TextBlock>

                        <TextBlock Text="Right-Click Context Menu:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Right-click anywhere on the assignments grid to access:
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,5,0,5">• Copy All Assignments</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Copy Selected Person's Tasks</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,5">• Swap with Another Person</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,15">• Export to CSV...</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced Features Tab -->
            <TabItem Header="⚡ Advanced Features">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Advanced Features Guide" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,20">
                            Enable only the features you need in Settings → Advanced Features. All features can be toggled on/off.
                        </TextBlock>

                        <!-- CORE FEATURES -->
                        <TextBlock Text="Core Features" FontSize="16" FontWeight="Bold" Margin="0,10,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="🚫 Task Constraints" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Exclude specific people from specific tasks based on allergies, physical limitations, or skill requirements.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3" FontStyle="Italic" Opacity="0.8">
                            Access: Edit → Task Constraints
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">
                            <Run FontWeight="Bold">Example:</Run> Exclude "John" from "Heavy Lifting" tasks
                        </TextBlock>

                        <TextBlock Text="📅 Persistent History" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            All assignments are automatically saved permanently with search, filtering by date/tag, and report generation capabilities.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            Access: Edit → Browse All History (Ctrl+Shift+H)
                        </TextBlock>

                        <!-- TASK MANAGEMENT -->
                        <TextBlock Text="Task Management" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="📊 Task Difficulty/Weighting" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Assign difficulty levels (Easy=1, Medium=2, Hard=3) to tasks for balanced distribution based on complexity, not just task count.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10">
                            <Run FontWeight="Bold">Benefit:</Run> Ensures no one gets all the hard tasks
                        </TextBlock>

                        <TextBlock Text="⏰ Task Time Estimates" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Assign time estimates (in minutes) to tasks for workload balancing based on actual time rather than just task count.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10">
                            <Run FontWeight="Bold">Example:</Run> "Clean Grill" = 30 min, "Refill Napkins" = 5 min
                        </TextBlock>

                        <TextBlock Text="📁 Task Categories" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Organize tasks into categories (Cleaning, Cooking, Service, Opening, Closing) for better organization and balanced distribution across categories.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            Access: Settings → Manage Categories, then Edit → Task Properties
                        </TextBlock>

                        <!-- PEOPLE MANAGEMENT -->
                        <TextBlock Text="People Management" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="✅ Person Availability" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Mark people as available or unavailable to temporarily exclude them from assignments without removing them from your list.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3">
                            <Run FontWeight="Bold">Perfect for:</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Sick days or time off</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Vacation schedules</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Part-time staff not working today</TextBlock>

                        <TextBlock Text="👔 Role-Based Assignment" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Assign roles to people (Server, Cook, Host, Manager) for structured team management and reporting.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            Setup: Settings → Manage Roles, then Edit → Person Availability
                        </TextBlock>

                        <!-- ASSIGNMENT FEATURES -->
                        <TextBlock Text="Assignment Features" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="🔄 Auto-Rotation System" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Track who has done which tasks over time and get suggestions for fair rotation. Ensures everyone eventually does every job.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            View Report: Tools → View Rotation Report
                        </TextBlock>

                        <TextBlock Text="📝 Assignment Templates" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Save successful assignments as templates and reuse them later. Perfect for standard shifts or recurring schedules.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3">
                            <Run FontWeight="Bold">How to use:</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">1. Assign tasks normally</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">2. Tools → Save as Template</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">3. Later: Tools → Load Template to reuse</TextBlock>

                        <TextBlock Text="💬 Assignment Notes" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Add notes or comments to assignments to track special circumstances, changes, or important context.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10">
                            <Run FontWeight="Bold">Example:</Run> "Bob left early, Alice covered his closing tasks"
                        </TextBlock>

                        <TextBlock Text="📅 Assignment Scheduler" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Schedule assignments for specific dates and times, with support for recurring assignments (daily, weekly, monthly).
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3">
                            <Run FontWeight="Bold">Features:</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Schedule assignments for future dates</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Set up recurring assignments</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• View upcoming scheduled assignments</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Enable/disable schedules without deleting</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Execute scheduled assignments manually</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            Access: Tools → Assignment Scheduler
                        </TextBlock>

                        <!-- WORKFLOW TOOLS -->
                        <TextBlock Text="Workflow Tools" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="🔄 Quick Swap" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Instantly exchange all tasks between two people for last-minute schedule changes or call-outs.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3">
                            <Run FontWeight="Bold">How to swap:</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">1. Right-click on a person in results</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">2. Select "Swap with Another Person..."</TextBlock>

                        <TextBlock Text="⚡ Bulk Edit Mode" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Select multiple tasks and edit their properties (category, difficulty, time) all at once. Saves tons of time when configuring many tasks!
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10" FontStyle="Italic" Opacity="0.8">
                            Access: Edit → Task Properties → Select multiple → Bulk Edit Selected
                        </TextBlock>

                        <!-- OUTPUT & ANALYTICS -->
                        <TextBlock Text="Output &amp; Analytics" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#1976d2"/>

                        <TextBlock Text="🖨️ Print Preview" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Generate professional, print-friendly assignment schedules perfect for posting on bulletin boards.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,10">
                            <Run FontWeight="Bold">Shortcut:</Run> Ctrl+P after assigning tasks
                        </TextBlock>

                        <TextBlock Text="📱 Mobile-Friendly Export" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            Generate mobile-optimized HTML pages with QR codes. Staff can scan the code to view their tasks on phones!
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,5,0,3">
                            <Run FontWeight="Bold">Features:</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Dark mode support</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,3">• Works offline (no internet needed)</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Print QR code for bulletin boards</TextBlock>

                        <TextBlock Text="📊 Performance Analytics" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
