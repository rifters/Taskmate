<Window x:Class="Taskmate.NotificationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Settings" Height="700" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notification Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1">
            <!-- Email Tab -->
            <TabItem Header="📧 Email">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <CheckBox x:Name="chkEmailEnabled" Content="Enable Email Notifications" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="SMTP Server Settings:" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,10"/>

                        <TextBlock Text="SMTP Server:" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtSmtpServer" Height="30" Margin="0,0,0,10" ToolTip="e.g., smtp.gmail.com"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Port:" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtSmtpPort" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text=" " Margin="0,0,0,3"/>
                                <CheckBox x:Name="chkSmtpUseSsl" Content="Use SSL/TLS" VerticalAlignment="Center" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Authentication:" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,10"/>

                        <TextBlock Text="Username:" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtSmtpUsername" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Password:" Margin="0,5,0,3"/>
                        <PasswordBox x:Name="txtSmtpPassword" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Email Addresses:" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,10"/>

                        <TextBlock Text="From Address:" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtEmailFrom" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="To Address:" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtEmailTo" Height="30" Margin="0,0,0,10"/>

                        <Border Background="#e3f2fd" Padding="15" Margin="0,20,0,10" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Email Setup Guide" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,5,0,5">
                                    <Run FontWeight="Bold">Gmail:</Run> smtp.gmail.com:587 (Enable "App Passwords" in Google Account settings)
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                                    <Run FontWeight="Bold">Outlook:</Run> smtp-mail.outlook.com:587
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11">
                                    <Run FontWeight="Bold">Office 365:</Run> smtp.office365.com:587
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Test Email" Width="120" Height="35" HorizontalAlignment="Left" Margin="0,10,0,0" Click="btnTestEmail_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SMS Tab -->
            <TabItem Header="📱 SMS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <CheckBox x:Name="chkSmsEnabled" Content="Enable SMS Notifications" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border Background="#fff3cd" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Twilio Account Required" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                                    SMS notifications require a Twilio account. Sign up for free at twilio.com to get your Account SID and Auth Token.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0">
                                    <Run FontWeight="Bold">Free Trial:</Run> Twilio provides $15.50 in free credit for testing!
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Twilio Credentials:" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,10"/>

                        <TextBlock Text="Account SID:" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtTwilioAccountSid" Height="30" Margin="0,0,0,10" FontFamily="Consolas"/>

                        <TextBlock Text="Auth Token:" Margin="0,5,0,3"/>
                        <PasswordBox x:Name="txtTwilioAuthToken" Height="30" Margin="0,0,0,10" FontFamily="Consolas"/>

                        <TextBlock Text="Phone Numbers:" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,10"/>

                        <TextBlock Text="From Number (Twilio):" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtTwilioFromNumber" Height="30" Margin="0,0,0,5" ToolTip="e.g., +15551234567"/>
                        <TextBlock Text="Format: +1234567890" FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

                        <TextBlock Text="To Number (Your Phone):" Margin="0,5,0,3"/>
                        <TextBox x:Name="txtSmsToNumber" Height="30" Margin="0,0,0,5" ToolTip="e.g., +15551234567"/>
                        <TextBlock Text="Format: +1234567890" FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

                        <Border Background="#e3f2fd" Padding="15" Margin="0,20,0,10" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="📋 Setup Steps:" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,3">
                                    1. Sign up at twilio.com/try-twilio
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,3">
                                    2. Get a phone number from Twilio Console
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,3">
                                    3. Find Account SID and Auth Token in Console
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,3">
                                    4. Enter credentials above and test!
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Test SMS" Width="120" Height="35" HorizontalAlignment="Left" Margin="0,10,0,0" Click="btnTestSms_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>