<Window x:Class="Taskmate.PerformanceDashboardWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:Taskmate"
xmlns:oxy="http://oxyplot.org/wpf"
Title="Performance Dashboard" Height="1200" Width="1400"
WindowStartupLocation="CenterOwner"
ResizeMode="CanResize"
Background="#f5f5f5">
<Window.Resources>
    <local:CompletionStatusColorConverter x:Key="CompletionStatusColorConverter"/>
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderBrush" Value="#e0e0e0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,15,20,0">
            <TextBlock Text="Performance Dashboard" FontSize="28" FontWeight="Bold" Foreground="#1976d2"/>
            <TextBlock x:Name="txtDashboardInfo" Text="Real-time analytics and performance metrics" FontSize="12" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="20,15,20,0" CornerRadius="8" BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dtFrom" Grid.Column="1" Height="32" SelectedDateChanged="Filter_Changed"/>

                <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dtTo" Grid.Column="3" Height="32" SelectedDateChanged="Filter_Changed"/>

                <TextBlock Grid.Column="4" Text="Person:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbPerson" Grid.Column="5" Height="32" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All People" IsSelected="True"/>
                </ComboBox>

                <Button Grid.Column="7" Content="Refresh" HorizontalAlignment="Right" Width="100" Height="32" Click="btnRefresh_Click" Background="#2196f3" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Dashboard Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
            <StackPanel>
                <!-- Row 1: Key Metrics -->
                <TextBlock Text="Key Metrics" FontSize="16" FontWeight="Bold" Margin="20,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Assignments -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total Assignments" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtTotalAssignments" Text="0" FontSize="32" FontWeight="Bold" Foreground="#1976d2"/>
                            <TextBlock x:Name="txtTotalAssignmentsTrend" FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Completion Rate -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Average Completion" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtAvgCompletion" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#4caf50"/>
                            <TextBlock x:Name="txtCompletionTrend" FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Complete Count -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Fully Completed" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtCompleteCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4caf50"/>
                            <TextBlock x:Name="txtCompletePercent" FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Partial Count -->
                    <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Partial" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtPartialCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#ff9800"/>
                            <TextBlock x:Name="txtPartialPercent" FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Incomplete Count -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Incomplete" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtIncompleteCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#f44336"/>
                            <TextBlock x:Name="txtIncompletePercent" FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Top Performers & Problematic Tasks -->
                <TextBlock Text="Performance Analysis" FontSize="16" FontWeight="Bold" Margin="20,20,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Performers -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="10,10,5,10">
                        <StackPanel>
                            <TextBlock Text="Top Performers" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgTopPerformers" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Person" Binding="{Binding Person}" Width="*"/>
                                    <DataGridTextColumn Header="Completion %" Binding="{Binding CompletionRate, StringFormat=\{0:F0\}}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Most Incomplete Tasks -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="5,10,10,10">
                        <StackPanel>
                            <TextBlock Text="Most Incomplete Tasks" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgProblematicTasks" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*"/>
                                    <DataGridTextColumn Header="Incomplete %" Binding="{Binding IncompleteRate, StringFormat=\{0:F0\}}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#f44336"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2.5: Charts -->
                <TextBlock Text="Visual Analytics" FontSize="16" FontWeight="Bold" Margin="20,20,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Completion Trend Chart -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="10,10,5,10">
                        <oxy:PlotView x:Name="chartCompletionTrend" Height="300" Background="White"/>
                    </Border>

                    <!-- Completion Status Chart -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="5,10,10,10">
                        <oxy:PlotView x:Name="chartCompletionStatus" Height="300" Background="White"/>
                    </Border>
                </Grid>

                <!-- Person Performance Chart -->
                <TextBlock Text="Top Performers Chart" FontSize="16" FontWeight="Bold" Margin="20,20,0,10"/>
                <Border Style="{StaticResource MetricCardStyle}" Margin="10,10,10,20">
                    <oxy:PlotView x:Name="chartPersonPerformance" Height="350" Background="White"/>
                </Border>

                <!-- Row 3: Recent Activity -->
                <TextBlock Text="Recent Activity" FontSize="16" FontWeight="Bold" Margin="20,20,0,10"/>
                <Border Style="{StaticResource MetricCardStyle}" Margin="10,10,10,20">
                    <DataGrid x:Name="dgRecentActivity" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat=\{0:g\}}" Width="150"/>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="120"/>
                            <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="150"/>
                            <DataGridTextColumn Header="People" Binding="{Binding Assignments.Count}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Completion %" Binding="{Binding OverallCompletionPercentage, StringFormat=\{0:F0\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,15">
            <Button Content="Copy Report" Width="120" Height="35" Margin="0,0,10,0" Click="btnExportDashboard_Click" Background="#e3f2fd" Foreground="Black"/>
            <Button Content="Export PDF" Width="120" Height="35" Margin="0,0,10,0" Click="btnExportPDF_Click" Background="#fff3e0" Foreground="Black"/>
            <Button Content="Export Excel" Width="120" Height="35" Margin="0,0,10,0" Click="btnExportExcel_Click" Background="#e3f2fd" Foreground="Black"/>
            <Button Content="Refresh Now" Width="120" Height="35" Margin="0,0,10,0" Click="btnRefresh_Click" Background="#4caf50" Foreground="White"/>
            <Button Content="Close" Width="100" Height="35" Click="btnClose_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
