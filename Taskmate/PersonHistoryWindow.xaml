<Window x:Class="Taskmate.PersonHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Person Task History" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Person Task History" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Person Selection -->
        <Border Grid.Row="1" Background="#f5f5f5" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Select Person" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="cmbPerson" Width="250" Height="35" Padding="10" FontSize="12" SelectionChanged="cmbPerson_SelectionChanged"/>
                    <TextBlock Text="Total Assignments:" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalAssignments" Text="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#1976d2"/>
                    
                    <TextBlock Text="Avg Tasks:" Margin="40,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtAvgTasks" Text="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#388e3c"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Date Range Filter -->
        <Border Grid.Row="2" Background="#f5f5f5" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Filter by Date Range (Optional)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="dpStartDate" Width="130" Height="35" Padding="10"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <DatePicker x:Name="dpEndDate" Width="130" Height="35" Padding="10"/>
                    <Button Content="Filter" Width="80" Height="35" Margin="20,0,0,0" Click="btnFilter_Click"/>
                    <Button Content="Clear Filter" Width="100" Height="35" Margin="5,0,0,0" Click="btnClearFilter_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- History DataGrid -->
        <DataGrid Grid.Row="3" x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat=\{0:g\}}" Width="170"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="150"/>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="120"/>
                <DataGridTextColumn Header="Tasks Assigned" Binding="{Binding TasksCount}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Workload %" Binding="{Binding WorkloadPercentage}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Tasks" Binding="{Binding Tasks}" Width="*"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding UserNotes}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stats Panel -->
        <Border Grid.Row="4" Background="#e3f2fd" Padding="15" CornerRadius="5" BorderBrush="#1976d2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Tasks" FontSize="11" Opacity="0.8"/>
                    <TextBlock x:Name="txtStatsTotal" Text="0" FontSize="16" FontWeight="Bold" Foreground="#1976d2"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Highest Assignment" FontSize="11" Opacity="0.8"/>
                    <TextBlock x:Name="txtStatsMax" Text="0" FontSize="16" FontWeight="Bold" Foreground="#388e3c"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Lowest Assignment" FontSize="11" Opacity="0.8"/>
                    <TextBlock x:Name="txtStatsMin" Text="0" FontSize="16" FontWeight="Bold" Foreground="#d32f2f"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Assignment Count" FontSize="11" Opacity="0.8"/>
                    <TextBlock x:Name="txtStatsCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="#f57c00"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
