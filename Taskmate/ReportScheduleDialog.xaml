<Window x:Class="Taskmate.ReportScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Schedule" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Schedule Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Schedule Name -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Schedule Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Height="32" Padding="10,8"/>

        <!-- Frequency -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
        <ComboBox x:Name="cmbFrequency" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,15,0,0" SelectionChanged="cmbFrequency_SelectionChanged">
            <ComboBoxItem Content="Daily" IsSelected="True"/>
            <ComboBoxItem Content="Weekly"/>
            <ComboBoxItem Content="Monthly"/>
        </ComboBox>

        <!-- Day of Week (Weekly) -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Day:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
        <ComboBox x:Name="cmbDayOfWeek" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,15,0,0" Visibility="Collapsed">
            <ComboBoxItem Content="Monday" IsSelected="True"/>
            <ComboBoxItem Content="Tuesday"/>
            <ComboBoxItem Content="Wednesday"/>
            <ComboBoxItem Content="Thursday"/>
            <ComboBoxItem Content="Friday"/>
            <ComboBoxItem Content="Saturday"/>
            <ComboBoxItem Content="Sunday"/>
        </ComboBox>

        <!-- Day of Month (Monthly) -->
        <ComboBox x:Name="cmbDayOfMonth" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,15,0,0" Visibility="Collapsed">
            <!-- Populated by code -->
        </ComboBox>

        <!-- Time -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Time (24h):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Text="Hour:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbHour" Width="70" Height="32">
                <!-- Populated by code -->
            </ComboBox>
            <TextBlock Text="Minute:" VerticalAlignment="Center" Margin="15,0,8,0"/>
            <ComboBox x:Name="cmbMinute" Width="70" Height="32">
                <!-- Populated by code -->
            </ComboBox>
        </StackPanel>

        <!-- Report Type -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Report Type:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
        <ComboBox x:Name="cmbReportType" Grid.Row="5" Grid.Column="1" Height="32" Margin="0,15,0,0">
            <ComboBoxItem Content="Statistics Only"/>
            <ComboBoxItem Content="Dashboard Only"/>
            <ComboBoxItem Content="Both" IsSelected="True"/>
        </ComboBox>

        <!-- Output Folder -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBox x:Name="txtOutputFolder" Height="32" Padding="10,8" Margin="0,0,10,0"/>
            <Button Content="Browse..." Width="80" Height="32" Click="btnBrowseFolder_Click"/>
        </StackPanel>

        <!-- Enable Checkbox -->
        <CheckBox x:Name="chkEnabled" Grid.Row="7" Grid.Column="1" Content="Enabled" Margin="0,15,0,0" IsChecked="True" VerticalAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="100" Height="35" Click="btnSave_Click" Background="#4caf50" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
