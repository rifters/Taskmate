<Window x:Class="Taskmate.ReportScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskmate"
        Title="Report Schedule Manager" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo Header -->
        <Border Grid.Row="0" Background="#e8f5e9" Padding="10" CornerRadius="4" Margin="0,0,0,15" BorderBrush="#4caf50" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource LogoSmall}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="📅 Scheduled Report Manager" FontSize="16" FontWeight="Bold" Foreground="#2e7d32"/>
                    <TextBlock Text="Create automated daily, weekly, or monthly reports" FontSize="10" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Schedule Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnNewSchedule" Content="➕ New Schedule" Width="120" Height="35" Click="btnNewSchedule_Click" Background="#4caf50" Foreground="White"/>
            <Button x:Name="btnEditSchedule" Content="✏️ Edit" Width="100" Height="35" Margin="10,0,0,0" Click="btnEditSchedule_Click"/>
            <Button x:Name="btnDeleteSchedule" Content="🗑️ Delete" Width="100" Height="35" Margin="10,0,0,0" Click="btnDeleteSchedule_Click" Background="#f44336" Foreground="White"/>
            <Button x:Name="btnRunNow" Content="▶️ Run Now" Width="100" Height="35" Margin="10,0,0,0" Click="btnRunNow_Click" Background="#2196f3" Foreground="White"/>
        </StackPanel>

        <!-- Schedules List -->
        <DataGrid Grid.Row="2" x:Name="dgSchedules" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="dgSchedules_DoubleClick">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Schedule Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="100"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=\{0:hh\\:mm\}}" Width="80"/>
                <DataGridTextColumn Header="Report Type" Binding="{Binding ReportType}" Width="100"/>
                <DataGridTextColumn Header="Output Folder" Binding="{Binding OutputFolder}" Width="*"/>
                <DataGridTextColumn Header="Last Executed" Binding="{Binding LastExecuted, StringFormat=\{0:g\}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="View Logs" Width="100" Height="35" Margin="0,0,10,0" Click="btnViewLogs_Click"/>
            <Button Content="Close" Width="100" Height="35" Click="btnClose_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
