<Window x:Class="Taskmate.ScheduleAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Assignment" Height="500" Width="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Schedule New Assignment" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Name:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Group File:" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtGroupPath" Grid.Column="0" Height="30" IsReadOnly="True"/>
                <Button Content="Browse..." Grid.Column="1" Width="80" Height="30" Margin="5,0,0,0" Click="btnBrowse_Click"/>
            </Grid>

            <TextBlock Text="Scheduled Date &amp; Time:" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpDate" Height="30" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hour:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtHour" Grid.Column="1" Height="30" Text="9"/>
                <TextBlock Text="Minute:" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <TextBox x:Name="txtMinute" Grid.Column="3" Height="30" Text="00"/>
            </Grid>

            <CheckBox x:Name="chkRecurring" Content="Recurring Assignment" Margin="0,0,0,10" Checked="chkRecurring_Changed" Unchecked="chkRecurring_Changed"/>

            <StackPanel x:Name="pnlRecurrence" Visibility="Collapsed" Margin="20,0,0,15">
                <TextBlock Text="Recurrence:" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbRecurrence" Height="30" Margin="0,0,0,10">
                    <ComboBoxItem Content="Daily" IsSelected="True"/>
                    <ComboBoxItem Content="Weekly"/>
                    <ComboBoxItem Content="Monthly"/>
                </ComboBox>

                <TextBlock Text="Every:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtInterval" Grid.Column="0" Height="30" Text="1"/>
                    <TextBlock x:Name="txtIntervalLabel" Grid.Column="1" Text="day(s)" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="Notes (optional):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>