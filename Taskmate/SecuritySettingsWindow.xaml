<Window x:Class="Taskmate.SecuritySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Settings" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Security &amp; Compliance Settings" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Session Timeout -->
                <GroupBox Header="🔒 Session Timeout" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="chkEnableTimeout" Content="Enable session timeout (auto-close after inactivity)" 
                                  Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="Timeout after:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtTimeoutMinutes" Width="50" Text="30"/>
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,10,0,0">
                            Recommended for shared computers. Application will automatically close after the specified period of inactivity.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Audit Logging -->
                <GroupBox Header="📋 Audit Logging" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="chkEnableAudit" Content="Enable audit logging (track all changes)" 
                                  Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7">
                            Logs all changes including assignments, group saves, and settings changes. Required for enterprise compliance and security audits.
                        </TextBlock>
                        <Button Content="View Audit Log" Margin="0,10,0,0" Width="120" 
                                HorizontalAlignment="Left" Click="btnViewAudit_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- GDPR Compliance -->
                <GroupBox Header="🗑️ GDPR Compliance" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10">
                            Exercise your right to delete all personal data stored by this application.
                        </TextBlock>
                        <Button Content="Clear All Data" Width="130" HorizontalAlignment="Left" 
                                Click="btnClearData_Click" Background="#f44336" Foreground="White"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7" Margin="0,5,0,0" Foreground="Red">
                            ⚠️ WARNING: This permanently deletes ALL data and cannot be undone!
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>