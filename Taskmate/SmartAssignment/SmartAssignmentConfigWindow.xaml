<Window x:Class="Taskmate.SmartAssignment.SmartAssignmentConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Assignment Configuration"
        Width="500"
        Height="450"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="20">
        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch">
            <!-- Title -->
            <TextBlock Text="Scoring Configuration"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Adjust the importance of each factor in the scoring algorithm"
                       FontSize="11"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Capacity Weight -->
            <TextBlock x:Name="lblCapacity"
                       FontWeight="Bold"
                       Margin="0,0,0,5"
                       Text="Capacity: 25%"/>
            <Slider x:Name="slCapacity"
                    Minimum="0"
                    Maximum="100"
                    Value="25"
                    ValueChanged="Slider_ValueChanged"
                    Margin="0,0,0,15"
                    Height="24"/>

            <!-- Role Weight -->
            <TextBlock x:Name="lblRole"
                       FontWeight="Bold"
                       Margin="0,0,0,5"
                       Text="Role/Skills: 20%"/>
            <Slider x:Name="slRole"
                    Minimum="0"
                    Maximum="100"
                    Value="20"
                    ValueChanged="Slider_ValueChanged"
                    Margin="0,0,0,15"
                    Height="24"/>

            <!-- Success Rate Weight -->
            <TextBlock x:Name="lblSuccessRate"
                       FontWeight="Bold"
                       Margin="0,0,0,5"
                       Text="Success Rate: 30%"/>
            <Slider x:Name="slSuccessRate"
                    Minimum="0"
                    Maximum="100"
                    Value="30"
                    ValueChanged="Slider_ValueChanged"
                    Margin="0,0,0,15"
                    Height="24"/>

            <!-- Availability Weight -->
            <TextBlock x:Name="lblAvailability"
                       FontWeight="Bold"
                       Margin="0,0,0,5"
                       Text="Availability: 15%"/>
            <Slider x:Name="slAvailability"
                    Minimum="0"
                    Maximum="100"
                    Value="15"
                    ValueChanged="Slider_ValueChanged"
                    Margin="0,0,0,15"
                    Height="24"/>

            <!-- Balance Weight -->
            <TextBlock x:Name="lblBalance"
                       FontWeight="Bold"
                       Margin="0,0,0,5"
                       Text="Team Balance: 10%"/>
            <Slider x:Name="slBalance"
                    Minimum="0"
                    Maximum="100"
                    Value="10"
                    ValueChanged="Slider_ValueChanged"
                    Margin="0,0,0,20"
                    Height="24"/>

            <!-- Total -->
            <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="3" Margin="0,0,0,20">
                <TextBlock x:Name="lblTotal"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Text="Total: 100%"/>
            </Border>

            <!-- Explanation -->
            <TextBlock Text="Weights must sum to 100%. Higher values indicate greater importance in recommendations."
                       FontSize="10"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="btnReset"
                        Content="Reset to Default"
                        Click="BtnReset_Click"
                        Width="120"
                        Height="35"
                        Background="#FFF"
                        Foreground="#333"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        Cursor="Hand"/>

                <Button x:Name="btnCancel"
                        Content="Cancel"
                        Click="BtnCancel_Click"
                        Width="80"
                        Height="35"
                        Background="#F0F0F0"
                        Foreground="#333"
                        BorderThickness="1"
                        BorderBrush="#CCC"
                        Margin="0,0,10,0"
                        Cursor="Hand"/>

                <Button x:Name="btnSave"
                        Content="Save"
                        Click="BtnSave_Click"
                        Width="80"
                        Height="35"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
