<UserControl x:Class="Taskmate.SmartAssignment.SmartAssignmentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" 
             Height="Auto">
    <Border Background="#F5F5F5"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="4">
        <DockPanel Margin="12" LastChildFill="True">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Smart Suggestions" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           VerticalAlignment="Center"/>
                <Button x:Name="btnRefresh"
                        Content="Refresh"
                        Click="BtnRefresh_Click"
                        HorizontalAlignment="Right"
                        Padding="6,2"
                        FontSize="11"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- Info Text -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Click Assign to use recommendation"
                       FontSize="10"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Loading Indicator -->
            <TextBlock DockPanel.Dock="Top"
                       x:Name="txtLoading"
                       Text="Loading suggestions..."
                       FontSize="10"
                       Foreground="#999"
                       TextAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,10,0,10"/>

            <!-- Error Message -->
            <Border DockPanel.Dock="Top"
                    x:Name="errorBorder"
                    Background="#FFE5E5"
                    BorderBrush="#FF6B6B"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtError"
                           Foreground="#C41C3B"
                           TextWrapping="Wrap"
                           FontSize="10"/>
            </Border>

            <!-- Scrollable Suggestions List -->
            <ScrollViewer DockPanel.Dock="Top"
                          MaxHeight="400"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="suggestionsControl" 
                              Background="White"
                              Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" 
                                    BorderThickness="1" 
                                    Padding="10" 
                                    Margin="0,0,0,8"
                                    CornerRadius="3"
                                    Background="{Binding BackgroundColor}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Rank and Name with Assign Button -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <TextBlock>
                                                <Run Text="{Binding Rank, StringFormat='#{0}'}" 
                                                     FontWeight="Bold" 
                                                     Foreground="#333"/>
                                                <Run Text=" " />
                                                <Run Text="{Binding PersonName}" 
                                                     FontWeight="Bold" 
                                                     Foreground="#333"
                                                     FontSize="12"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding OverallScore, StringFormat={}{0:F0}%}" 
                                                      Foreground="#4CAF50" 
                                                      FontWeight="Bold"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1"
                                                Content="Assign"
                                                Tag="{Binding PersonName}"
                                                Click="BtnAssignPerson_Click"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                Padding="8,4"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Score Visualization -->
                                    <TextBlock Grid.Row="1"
                                              Text="{Binding ScoreVisualization}"
                                              FontFamily="Consolas"
                                              FontSize="10"
                                              Foreground="#555"
                                              Margin="0,0,0,6"/>

                                    <!-- Reason -->
                                    <TextBlock Grid.Row="2"
                                              Text="{Binding ReasonForScore}"
                                              Foreground="#999"
                                              FontSize="10"
                                              Margin="0,0,0,6"
                                              TextWrapping="Wrap"/>

                                    <!-- Warnings -->
                                    <ItemsControl Grid.Row="3"
                                                 ItemsSource="{Binding Warnings}"
                                                 Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                          Foreground="#FFA500" 
                                                          FontSize="9"
                                                          Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Strengths -->
                                    <ItemsControl Grid.Row="4"
                                                 ItemsSource="{Binding Strengths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                          Foreground="#4CAF50" 
                                                          FontSize="9"
                                                          Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Settings Button -->
            <Button DockPanel.Dock="Bottom"
                    x:Name="btnSettings"
                    Content="Configure Scoring"
                    Click="BtnSettings_Click"
                    Height="28"
                    Background="#F0F0F0"
                    Foreground="#333"
                    FontSize="10"
                    BorderThickness="1"
                    BorderBrush="#CCC"
                    Margin="0,8,0,0"
                    Cursor="Hand"/>
        </DockPanel>
    </Border>
</UserControl>
