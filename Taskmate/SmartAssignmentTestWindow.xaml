<Window x:Class="Taskmate.SmartAssignmentTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Assignment Engine - Test Demo" 
        Width="600" 
        Height="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="White">
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Smart Assignment Engine" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Testing intelligent person recommendations based on:" 
                       FontSize="11" 
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>
            
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Metrics (Weights):" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="- Capacity: 25%" Margin="5,0,0,2"/>
                    <TextBlock Text="- Role: 20%" Margin="5,0,0,2"/>
                    <TextBlock Text="- Success Rate: 30%" Margin="5,0,0,2"/>
                    <TextBlock Text="- Availability: 15%" Margin="5,0,0,2"/>
                    <TextBlock Text="- Team Balance: 10%" Margin="5,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Score Color Coding:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Rectangle Width="15" Height="15" Fill="#C8FFC8" Margin="5,0,5,0"/>
                        <TextBlock Text="80%+ (Excellent)" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Rectangle Width="15" Height="15" Fill="#FFFFC8" Margin="5,0,5,0"/>
                        <TextBlock Text="60-80% (Good)" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="15" Height="15" Fill="#FFC8C8" Margin="5,0,5,0"/>
                        <TextBlock Text="Below 60% (Fair)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <Separator Margin="0,10,0,10"/>
            
            <TextBlock Text="Top Recommendations:" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Window>
