<Window x:Class="Taskmate.SwapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swap Tasks Between People" Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Swap all tasks between two people:" FontSize="14" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Person 1:" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbPerson1" Grid.Row="2" Height="30" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Person 2:" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbPerson2" Grid.Row="4" Height="30"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Swap" Width="80" Height="35" Margin="0,0,10,0" Click="btnSwap_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>