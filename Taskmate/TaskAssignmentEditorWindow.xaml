<Window x:Class="Taskmate.TaskAssignmentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:smart="clr-namespace:Taskmate.SmartAssignment"
        Title="Task Assignment Editor" 
        Height="600" 
        Width="1400"
        WindowStartupLocation="CenterOwner">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Task List -->
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Available Tasks" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           x:Name="txtTaskCount"
                           Text="0 tasks"
                           FontSize="10"
                           Foreground="#666"
                           Margin="0,0,0,10"/>

                <ListBox Grid.Row="2"
                         x:Name="lbTasks"
                         SelectionChanged="LbTasks_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" Foreground="#333"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Middle: Task Details -->
        <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Task Details" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           Margin="0,0,0,15"/>

                <!-- Selected Task Name -->
                <Border Grid.Row="1" Background="#F5F5F5" Padding="12" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Task:" Foreground="#666" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtSelectedTask" 
                                   Text="(Select a task)" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="#333"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Currently Assigned To -->
                <Border Grid.Row="2" Background="#E8F5E9" Padding="12" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Currently Assigned To:" Foreground="#2e7d32" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtCurrentAssignee" 
                                   Text="(Unassigned)" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Foreground="#2e7d32"/>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
                    <Button x:Name="btnUnassign"
                            Content="??? Unassign Task"
                            Click="BtnUnassign_Click"
                            Background="#FFC8C8"
                            Foreground="#C41C3B"
                            Padding="10,8"
                            FontSize="11"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <Border Grid.Row="4" Background="White"/>

                <!-- Close Button -->
                <Button Grid.Row="5"
                        Content="Close"
                        Click="BtnClose_Click"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"
                        Background="#F0F0F0"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Right: Smart Suggestions -->
        <smart:SmartAssignmentPanel 
            x:Name="smartSuggestionsPanel"
            Grid.Column="2"
            PersonSelected="SmartSuggestionsPanel_PersonSelected"
            VerticalAlignment="Stretch"
            Margin="0"/>
    </Grid>
</Window>
