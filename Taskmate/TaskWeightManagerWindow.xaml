<Window x:Class="Taskmate.TaskWeightManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Task Difficulty/Weight" Height="550" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Set task difficulty for balanced distribution" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Higher weight = more difficult task (1=Easy, 2=Medium, 3=Hard)" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" x:Name="dgTasks" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Difficulty" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding WeightDisplay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="35" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>