<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\Icons\icon.ico</ApplicationIcon>
    
    <!-- Warning suppressions for unavoidable third-party library issues -->
    <NoWarn>$(NoWarn);CS8618;CS8619;CS8604;CS8601;CS8602;CS8625;NU1701</NoWarn>
    <!-- 
      CS8618: Non-nullable reference type is uninitialized (third-party libs)
      CS8619: Nullability of reference types doesn't match (third-party interop)
      CS8604: Possible null reference argument (third-party APIs)
      CS8601: Possible null reference assignment (third-party APIs)
      CS8602: Dereference of possibly null reference (third-party libs)
      CS8625: Cannot use null in parameter (third-party conversion)
      NU1701: Package compatibility issues
    -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\icon.ico" />
    <Resource Include="Assets\Icons\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.5.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.5.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="MailKit" Version="4.14.1" />
    <PackageReference Include="Twilio" Version="7.14.3" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Samples\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Samples\*.tgroup">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
