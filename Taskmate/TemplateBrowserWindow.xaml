<Window x:Class="Taskmate.TemplateBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assignment Templates" Height="550" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Assignment Templates" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Save and reuse successful task assignments" FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgTemplates" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Template Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat='{}{0:MM/dd/yyyy}'}" Width="100"/>
                <DataGridTextColumn Header="People" Binding="{Binding Assignments.Count}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Load Template" Width="120" Height="35" Margin="0,0,10,0" Click="btnLoad_Click" IsEnabled="{Binding SelectedItem, ElementName=dgTemplates, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Delete" Width="80" Height="35" Margin="0,0,10,0" Click="btnDelete_Click" IsEnabled="{Binding SelectedItem, ElementName=dgTemplates, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Close" Width="80" Height="35" Click="btnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>